{
  "name": "backend-coding-test-demo",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript GraphQL API server (Apollo Server + Node.js) for the Backend Engineer Code Test",
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "start:env": "node --env-file=.env dist/index.js",
    "start:ts": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "pretest": "npm run build",
    "test": "node tests/run.mjs",
    "pretest:node": "npm run build",
    "test:node": "node --test tests/",
    "presmoke": "npm run build",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@apollo/server": "^5.5.2",
    "@as-integrations/express5": "^1.1.2",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "graphql": "^16.11.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
