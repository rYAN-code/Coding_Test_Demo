# Bearer token(s) accepted by the GraphQL API. Comma-separated values are allowed.
# The value below is the default used when AUTH_TOKEN is not set (documented in the README).
AUTH_TOKEN=backend-test-token

# HTTP server
PORT=4000
HOST=0.0.0.0

# Apollo Sandbox explorer on GET / (set to false in production)
LANDING_PAGE=true

# Datasource directory holding node.json / trigger.json / response.json / action.json /
# resourceTemplate.json. Defaults to ./json next to package.json.
# DATA_DIR=./json
